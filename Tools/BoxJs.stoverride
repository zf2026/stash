name: |-
  BoxJs
desc: |-
  JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。
author: |-
  chavyleung[https://github.com/chavyleung]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/BoxJS.png
openUrl: |-
  http://boxjs.com
category: "Tools"

http:

  mitm:
    - "boxjs.com"
    - "boxjs.net"
    - "*.boxjs.com"
    - "*.boxjs.net"

  script:
    - match: (?i)^https?:\/\/(.+\.)?boxjs\.(com|net)
      name: "BoxJS_8"
      type: request
      require-body: true
      timeout: 120

script-providers:
  "BoxJS_8":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/boxjs.js
    interval: 86400
