name: |-
  ampDache
desc: |-
  高德打车签到
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1038.png

http:

  mitm:
    - "*.amap.com"

  script:
    - match: ^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?(?:[^#?&]+&)*_ENCRYPT=)
      name: "ampDache_8"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

cron:
  script:
    - name: "ampDache_8"
      cron: 1 0 * * *
      timeout: 120

script-providers:
  "ampDache_3":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/ampDache.js
    interval: 86400
