name: |-
  bizhi
desc: |-
  bizhi
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1092.png
category: "去广告"

http:

  mitm:
    - "buy.itunes.apple.com"

  script:
    - match: ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt
      name: "bizhi_1"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "bizhi_1":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/bizhi.js

    interval: 86400
