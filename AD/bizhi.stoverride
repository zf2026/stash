name: |-
  bizhi
desc: |-
  一次性解锁，[点恢复购买],解锁SVIP。切记先关闭同域名脚本!
icon: |-
  https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/VIP.png
category: "去广告"

http:

  mitm:
    - "buy.itunes.apple.com"

  script:
    - match: ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt
      name: "bizhi_1"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "bizhi_1":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/bizhi.js

    interval: 86400
