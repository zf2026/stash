name: |-
  🅳🅸🆂🅲🅾🆁🅳 Discord 自动翻译
desc: |-
  调用 Google 翻译为 Discord 历史消息生成双语对照，支持自定义翻译条目数量、目标语言及对应旗帜；新消息可能需重新进入频道触发刷新
author: |-
  LOWERTOP
icon: |-
  https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/refs/heads/main/img/Discord.png
arguments-desc: |-
  翻译条目数量：单次响应最多筛选的消息条数，默认 50，最大 1000。\n\n翻译目标语言：填写 Google 翻译支持的语言代码，默认 zh-CN（简体中文）。支持 zh-TW（台湾繁体）、zh-HK（香港繁体）、ja（日语）、ko（韩语）等。\n\n两个参数可以独立修改。
homepage: |-
  https://github.com/LOWERTOP/Shadowrocket-First

rules:
  - AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discord.com)),REJECT
  - AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discordapp.com)),REJECT

http:

  mitm:
    - "discord.com"
    - "discordapp.com"

  script:
    - match: ^https://(discord|discordapp).com/api/v\d+/channels/\d+/messages
      name: "Discord-Local-Translate_11"
      type: response
      require-body: true
      max-size: 524288
      timeout: 10
      argument: |-
        50|zh-CN

script-providers:
  "Discord-Local-Translate_11":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/discord_translate.js
    interval: 86400
