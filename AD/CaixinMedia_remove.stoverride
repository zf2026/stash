name: |-
  财新去广告
desc: |-
  过滤财新广告
author: |-
  RuCu6[https://github.com/RuCu6]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CaixinMedia.png
openUrl: |-
  https://apps.apple.com/app/id356023612
category: |-
  去广告
loon_version: |-
  3.5.1(998)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-10-02 13:57:49

http:

  mitm:
    - "e*.caixin.com"
    - "g*.caixin.com"
    - "m*.caixin.com"

  url-rewrite:
    - >-
      (?i)^https:\/\/entities\.caixin\.com\/api\/(dataplus\/promotionHints|public\/push\/appIndex|public\/recommendNews) - reject-dict
    - >-
      (?i)^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxAdInfo\/selectIndexAdInfo - reject-dict
    - >-
      (?i)^https:\/\/mappsv5\.caixin\.com\/channelv5\/article_ad_ios_info\.json - reject-dict
    - >-
      (?i)^https:\/\/gg\.caixin\.com\/s\?(?:[^#?&]+&)*z=caixin&slot=\d+ - reject-dict
    - >-
      (?i)^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist - reject-dict

  script:
    - match: (?i)^https:\/\/entities\.caixin\.com\/api\/dataplus\/columns
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

    - match: (?i)^https:\/\/gateway\.caixin\.com\/api\/app-api\/(caixinapp\/appinfo|search\/getkeyword)
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

    - match: (?i)^https:\/\/gateway\.caixin\.com\/api\/app-content\/fm\/index\/list\?
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

    - match: (?i)^https:\/\/gg\.caixin\.com\/s\?z=caixin&op=\d
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

    - match: (?i)^https:\/\/mappsv5\.caixin\.com\/articlev5\/\d+\/\d+\.json$
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

    - match: (?i)^https:\/\/mapps?v5\.caixin\.com\/(channelv5\/list|\/?index_page_v5\/)\w+
      name: "移除财新数据通广告_18"
      type: response
      require-body: true

script-providers:
  "移除财新数据通广告_18":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/CaixinMedia_remove_ads.js
    interval: 86400
