name: |-
  PSExpress
desc: |-
  PSExpress
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1008.png

http:

  mitm:
    - "lcs-mobile-cops.adobe.io"

  script:
    - match: https://lcs-mobile-cops.adobe.io/mobiles/access_profile/v3
      name: "PSExpress_3"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "PSExpress_3":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/PSExpress.js
    interval: 86400