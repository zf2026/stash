name: |-
  中医精华
desc: |-
  一次性解锁，切记关闭同域名脚本!
icon: |-
  https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/VIP.png
category: "去广告"

http:

  mitm:
    - "buy.itunes.apple.com"

  script:
    - match: ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt
      name: "zyjh_3"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "zyjh_3":
    url: https://raw.githubusercontent.com/zf2026/stash/refs/heads/main/script/itunes/zyjh.js
    interval: 86400
