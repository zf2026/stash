name: |-
  星空
desc: |-
  一次性解锁订阅,切记先关闭同域名脚本!
icon: |-
  https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/VIP.png

category: "去广告"
http:

  mitm:
    - "buy.itunes.apple.com"

  script:
    - match: ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt
      name: "Xk_2"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "Xk_2":
    url: https://raw.githubusercontent.com/Yu9191/Rewrite/main/itunes/Xk.js
    interval: 86400
