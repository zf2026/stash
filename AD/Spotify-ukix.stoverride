name: |-
  🆂🅿🅾🆃🅸🅵🆈 声破天解锁
desc: |-
  会员配置、首页与播放页去广告，集成歌词补全和双语翻译。支持编辑参数，可以调整歌词部分选项，增加百度翻译开放平台服务以增强翻译成功率。脚本来源：Reukix
author: |-
  Reukix
icon: |-
  https://raw.githubusercontent.com/LOWERTOP/ShadowRule/refs/heads/master/icon/color/spotify.png
arguments-desc: |-
  \n\n模块说明：请停用其他 Spotify 歌词模块，避免重复处理同一接口。若歌词存在官方歌词则优先选用；外部歌词按歌名、歌手和时长匹配；默认使用网易、谷歌等翻译，支持选填百度翻译APPID，启用后若不存在网易人工翻译，则首选百度翻译，可一定程度上避免翻译受限。 \n\n脚本来源：Reukix \n\n歌词补全：启用歌词补全 \n\n歌词翻译：启用歌词翻译 \n\n翻译语言：翻译目标语言，默认 zh-CN \n\n百度翻译：启用百度翻译 \n\n翻译账户：百度翻译开放平台的 APP ID \n\n翻译密钥：百度翻译开放平台的密钥
version: |-
  Based on @Reukix v2026.11.16.1
homepage: |-
  https://github.com/Reukix/ukix

rules:
  - AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
  - DOMAIN,aet.spotify.com,REJECT

http:

  mitm:
    - "spclient.wg.spotify.com"
    - "spclient.spotify.com"
    - "*spclient.spotify.com"
    - "*-spclient.wg.spotify.com"

  header-rewrite:
    - >-
      ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(?:\?[^#]*)?$ request-del if-none-match

  url-rewrite:
    - >-
      ^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject
    - >-
      ^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject
    - >-
      ^https:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject
    - >-
      ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service - reject-200

  script:
    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v1\/home\/default\/?(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 5

    - match: ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 5

    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify:[^?#]+(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 8
      argument: |-
        Lyrics="true"&Translate="true"&TargetLanguage="zh-CN"&BaiduTranslate="false"&BaiduAppId="自行申请并填写"&BaiduKey="自行申请并填写"

    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[A-Za-z0-9]{22}(?:\/image\/[^/?#]+)?\/?(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 20
      argument: |-
        Lyrics="true"&Translate="true"&TargetLanguage="zh-CN"&BaiduTranslate="false"&BaiduAppId="自行申请并填写"&BaiduKey="自行申请并填写"

    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:extended-metadata\/v0\/extended-metadata|metadata\/4\/track\/[a-fA-F0-9]{32})(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 5
      argument: |-
        Lyrics="true"&Translate="true"&TargetLanguage="zh-CN"&BaiduTranslate="false"&BaiduAppId="自行申请并填写"&BaiduKey="自行申请并填写"

    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/connect-state\/v1\/devices\/[^/?#]+\/?(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 5
      argument: |-
        Lyrics="true"&Translate="true"&TargetLanguage="zh-CN"&BaiduTranslate="false"&BaiduAppId="自行申请并填写"&BaiduKey="自行申请并填写"

    - match: ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(?:\?[^#]*)?$
      name: "spotify-home_20"
      type: response
      require-body: true
      max-size: 2097152
      binary-mode: true
      timeout: 5

script-providers:
  "spotify-home_20":
    url: https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify.js
    interval: 86400
